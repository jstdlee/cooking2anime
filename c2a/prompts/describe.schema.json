{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChunkDescription",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjects", "setting", "food_state", "beats", "gestures", "emotion", "camera",
               "person_visible", "sound_cues"],
  "properties": {
    "subjects": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "setting": {"type": "string"},
    "food_state": {"type": "string"},
    "beats": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["t0", "t1", "action"],
        "properties": {"t0": {"type": "number"}, "t1": {"type": "number"},
                       "action": {"type": "string"}}
      }
    },
    "gestures": {"type": "array", "items": {"type": "string"}},
    "emotion": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "intensity", "t"],
      "properties": {"label": {"type": "string"}, "intensity": {"type": "integer"},
                     "t": {"type": "number"}}
    },
    "camera": {"type": "string"},
    "person_visible": {"type": "boolean"},
    "sound_cues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["t0", "t1", "cue"],
        "properties": {"t0": {"type": "number"}, "t1": {"type": "number"},
                       "cue": {"type": "string"}}
      }
    }
  }
}
